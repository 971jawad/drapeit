{
  "name": "drapeit-render-api",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "vars": { "ALLOWED_ORIGINS": "https://971jawad.github.io" },
  "kv_namespaces": [
    { "binding": "JOBS", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
